face-swap/models/*.onnx
face-swap/models/*.pth
face-swap/models/*.pt
face-swap/models/buffalo_l/

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# Temp
/tmp/
*.tmp
